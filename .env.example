# ---------------------------------------------------------------- 模型服务
# 主供应方：dashscope（qwen-max）或 openai；两者都走 OpenAI 兼容协议。
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# 切换 OpenAI：LLM_PROVIDER=openai，并填写下面三项。
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# 向量化可独立选择供应方；留空跟随 LLM_PROVIDER。
EMBEDDING_PROVIDER=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 必须与 Milvus collection 的向量维度一致（text-embedding-v4 默认 1024；
# OpenAI text-embedding-3-small 是 1536，切换时须重建 collection）。
EMBEDDING_DIM=1024

# ---------------------------------------------------------------- 基础设施
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/travel_agent
REDIS_URL=redis://localhost:6379/0
MILVUS_HOST=localhost
MILVUS_PORT=19530
LOG_LEVEL=INFO
APP_ENV=dev

# ---------------------------------------------------------------- 鉴权
# 生产：由 SSO 下发 token，用 AUTH_TOKENS_JSON 配置或替换 PrincipalResolver。
# 本地：设置 AUTH_DEV_TOKEN 后用 `Authorization: Bearer <token>` 调接口。
# 两者都为空时所有需鉴权接口返回 401（失败关闭，不会退化成匿名可写）。
AUTH_REQUIRED=true
AUTH_DEV_TOKEN=dev-local-token
# AUTH_TOKENS_JSON={"tok-a":{"subject_id":"E10086","display_name":"张三","tenant_id":"acme","department":"市场部","requester_level":"manager","cost_center":"CC-MKT-01","manager_id":"E10001","budget_codes":["BUD-MKT-2026"],"scopes":["chat","trip:draft","trip:book","trip:approve","knowledge:read"]}}

# 不要用 "*"：与 allow_credentials=true 组合会被浏览器拒绝，且接入鉴权后是实质漏洞。
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- 记忆
SESSION_TTL_SECONDS=604800
MEMORY_MAX_GROUPS=24
MEMORY_MAX_TOKENS=8000
# 必须小于 MEMORY_MAX_TOKENS，否则窗口先裁剪、摘要永不触发
MEMORY_SUMMARY_TRIGGER_TOKENS=5200
MEMORY_KEEP_RECENT_GROUPS=8
LTM_COLLECTION=travel_memory
LTM_DEFAULT_TTL_DAYS=180

# ---------------------------------------------------------------- Harness 预算
HARNESS_MAX_ITERATIONS=8
HARNESS_MAX_TOOL_CALLS=12
HARNESS_DEADLINE_SECONDS=90
HARNESS_MAX_TOTAL_TOKENS=32000
TOOL_TIMEOUT_SECONDS=15
TOOL_MAX_REPAIR_ATTEMPTS=2
CONFIRMATION_TTL_SECONDS=1800

# ---------------------------------------------------------------- 差旅编排
ROUTER_CONFIDENCE_THRESHOLD=0.85
# on = 多范式路由；off = 单 ReAct 基线（仅压测/离线 A/B）
ROUTER_MODE=on
BOOKING_PRICE_TOLERANCE=0.02
TRAVEL_POLICY_VERSION=2026.11-v1
POLICY_VERSION=2026.08-v1
AUDIT_ENABLED=true
PROMPT_VERSION=2026.11.11-1

# ---------------------------------------------------------------- 可观测性
# 留空则不导出 trace；设置后走 OTLP/HTTP
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=false
